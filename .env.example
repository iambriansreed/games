# Copy to .env.local for local dev (loaded by `npm run dev:api`).

# Postgres connection string (Railway provides DATABASE_URL automatically in prod).
# For local dev, point at a local or Railway Postgres instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/games

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials).
# Add BOTH of these as Authorized redirect URIs in the Google console:
#   http://127.0.0.1:4567/api/auth/google/callback   (local dev)
#   https://games.iambrian.com/api/auth/google/callback         (production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# In dev the request reaches the API through the Vite proxy, so pin the
# redirect URI to the local dev origin. In prod it's derived from the request
# host automatically (or pin it to https://games.iambrian.com/...).
GOOGLE_REDIRECT_URI=http://local.games.iambrian.com/api/auth/google/callback

# Optional comma-separated allowlist of emails permitted to sign in.
# GAMES_ALLOWED_EMAILS=

# Single admin account. When the signed-in user's email matches, the settings
# page shows a Dev tools section (load Splendor test scenarios, etc.).
# GAMES_ADMIN_EMAIL=

# Port the API listens on (Railway sets PORT automatically).
PORT=1010
